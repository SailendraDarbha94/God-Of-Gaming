{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../packages/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "noEmit": true,
    // This program type-checks the player app's own modules (theme, copy, formatters, app.config.ts),
    // and the player compiles with this off (packages/tsconfig/expo.json).
    "exactOptionalPropertyTypes": false,
    "typeRoots": ["../../node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@app/*": ["../../apps/player/src/*"],
      "@gog/domain": ["../../packages/domain/src/index.ts"],
      "@gog/data": ["../../packages/data/src/index.ts"],
      "@gog/data/*": ["../../packages/data/src/*"],
      "@board/*": ["./*"]
    }
  },
  "include": ["*.ts", "components/**/*.ts", "screens/**/*.ts", "tools/**/*.ts"]
}
