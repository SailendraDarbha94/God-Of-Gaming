# Copy to .env.local (git-ignored). Variables prefixed NEXT_PUBLIC_ are inlined into the JavaScript the
# browser downloads, at build time, and are therefore public: never put a service-role key or any
# secret here (ADR 0011). next.config.ts refuses a secret key before anything is bundled, and the dev
# server must be restarted after a change.

# Where the app reads data from: `supabase` (default) or `fixtures` (the in-memory sample world from
# @gog/data, one per browser tab; any persona number signs in with code 123456 from M1). On Vercel the
# production deployment (VERCEL_ENV=production) refuses `fixtures` at build time.
NEXT_PUBLIC_GOG_DATA_SOURCE=fixtures

# Supabase project URL and anon (publishable) key. Required when NEXT_PUBLIC_GOG_DATA_SOURCE=supabase,
# and checked at build time on Vercel. Local: `supabase start` prints both. Hosted: Project settings >
# API. The key must be the anon/publishable key: an sb_secret_ key or a service_role JWT is refused.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the showcase website (apps/web), for "View public page" on a listed cafe. Optional.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
