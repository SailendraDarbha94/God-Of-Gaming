# Copy to apps/web/.env.local for local development. Nothing here is secret: the website only
# ever holds the public (anon) Supabase key (ADR 0004, ADR 0011).

# Where the catalog comes from: `supabase` (default) or `fixtures` (in-memory sample data, no
# backend needed). Production deployments (NODE_ENV=production and VERCEL_ENV=production) refuse
# `fixtures` at startup.
GOG_DATA_SOURCE=fixtures

# Supabase project URL, e.g. https://abcdefgh.supabase.co. Required when GOG_DATA_SOURCE=supabase.
# Also used to allow the project's public storage host in next/image.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Required when GOG_DATA_SOURCE=supabase. Never the service-role key:
# env.ts refuses a service-role key or a user token at startup (ADR 0011).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this site, used for canonical URLs, Open Graph, the sitemap and robots.txt.
# Required on the production deployment (NODE_ENV and VERCEL_ENV both production); defaults to
# http://localhost:3000 everywhere else, including `next build` with fixtures on a clean clone.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# iOS App Store numeric id (e.g. 123456789) for the Smart App Banner (`metadata.itunes.appId`).
# Leave empty until the app is in App Store Connect.
NEXT_PUBLIC_IOS_APP_ID=

# Full App Store URL for the player app. Leave empty to show "Coming soon" on the store button.
NEXT_PUBLIC_APP_STORE_URL=

# Full Google Play URL for the player app. Leave empty to show "Coming soon" on the store button.
NEXT_PUBLIC_PLAY_STORE_URL=

# Apple Developer Team ID for /.well-known/apple-app-site-association (Universal Links).
# The file is served only when both APPLE_TEAM_ID and IOS_BUNDLE_ID are set; otherwise 404.
APPLE_TEAM_ID=

# iOS bundle identifier of the player app, e.g. in.godofgaming.player.
IOS_BUNDLE_ID=

# Android application id for /.well-known/assetlinks.json (App Links), e.g. in.godofgaming.player.
# The file is served only when both ANDROID_PACKAGE and ANDROID_SHA256_FINGERPRINTS are set.
ANDROID_PACKAGE=

# Comma-separated SHA-256 signing certificate fingerprints (colon-separated hex pairs) of the
# Android app, from `keytool -list -v` or the Play Console (app signing key).
ANDROID_SHA256_FINGERPRINTS=
