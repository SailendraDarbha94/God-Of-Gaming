# Copy to .env (git-ignored). Variables prefixed EXPO_PUBLIC_ are inlined into the JavaScript bundle
# at build time and are therefore public: never put a service-role key or any secret here (ADR 0011).
# Because they are inlined, the dev server must be restarted after a change.

# Where the app reads data from: `supabase` (default) or `fixtures` (the in-memory sample dataset
# from @gog/data/fixtures; no backend needed, holds live only for the process lifetime).
# Release bundles (EAS `preview` and `production`, `expo run --configuration Release`, `expo export`,
# `expo start --no-dev`) refuse `fixtures` at startup and must set `supabase` (ADR 0012); the
# development build accepts either.
EXPO_PUBLIC_DATA_SOURCE=fixtures

# Supabase project URL and anon (public) key. Required when EXPO_PUBLIC_DATA_SOURCE=supabase.
# Local: `supabase start` prints both. Hosted: Project settings > API.
# 127.0.0.1 is the device's own loopback, so it reaches the Mac only from the iOS simulator; use
# http://10.0.2.2:54321 on the Android emulator and http://<your Mac's LAN IP>:54321 on a phone.
# The key must be the anon/publishable key: env.ts refuses a service-role key or a user token.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the showcase website (apps/web). Used for the privacy and terms links in the app and,
# at config time, for the Universal Link / App Link host: only an https URL produces
# ios.associatedDomains and android.intentFilters in app.config.ts.
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# Native identifiers, read by app.config.ts at config time (not inlined into the bundle). They must
# match APPLE_TEAM_ID / IOS_BUNDLE_ID / ANDROID_PACKAGE in apps/web, which serves the
# apple-app-site-association and assetlinks.json files that verify these links.
IOS_BUNDLE_ID=com.gog.player
ANDROID_PACKAGE=com.gog.player

# EAS project id (eas.dev > project > Overview). Placeholder until the project exists.
EAS_PROJECT_ID=
