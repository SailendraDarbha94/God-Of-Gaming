# React Native tooling (Metro, autolinking, Gradle and CocoaPods scripts) expects a flat
# node_modules. Re-check the Expo monorepo guide at each SDK upgrade and drop this when it
# is no longer needed (ADR 0002).
node-linker=hoisted

# Peer dependency problems stay warnings: eslint-plugin-import, eslint-plugin-react and
# eslint-plugin-jsx-a11y (pulled in by eslint-config-next and eslint-config-expo) still declare
# an eslint ^9 peer although they run on ESLint 10 (docs/spec/CHANGELOG.md, ESLint 10 entry).
strict-peer-dependencies=false
auto-install-peers=true
