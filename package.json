{
  "name": "god-of-gaming",
  "private": true,
  "version": "0.0.0",
  "description": "Gaming cafe booking aggregator: showcase website, player app and Supabase backend",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@gog/web",
    "dev:player": "pnpm --filter @gog/player start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/data/src/database.types.ts && prettier --write packages/data/src/database.types.ts",
    "db:local:up": "scripts/db/local.sh up",
    "db:local:down": "scripts/db/local.sh down",
    "db:local:reset": "scripts/db/local.sh reset",
    "db:local:test": "scripts/db/local.sh test",
    "db:local:types": "scripts/db/local.sh types",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@supabase/postgres-meta": "0.98.0",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
